--cpu Cortex-M3
"uart_lab\startup_stm32f103xb.o"
"uart_lab\main.o"
"uart_lab\stm32f1xx_it.o"
"uart_lab\stm32f1xx_hal_msp.o"
"uart_lab\stm32f1xx_hal_gpio_ex.o"
"uart_lab\stm32f1xx_hal_uart.o"
"uart_lab\stm32f1xx_hal.o"
"uart_lab\stm32f1xx_hal_rcc.o"
"uart_lab\stm32f1xx_hal_rcc_ex.o"
"uart_lab\stm32f1xx_hal_gpio.o"
"uart_lab\stm32f1xx_hal_dma.o"
"uart_lab\stm32f1xx_hal_cortex.o"
"uart_lab\stm32f1xx_hal_pwr.o"
"uart_lab\stm32f1xx_hal_flash.o"
"uart_lab\stm32f1xx_hal_flash_ex.o"
"uart_lab\stm32f1xx_hal_exti.o"
"uart_lab\system_stm32f1xx.o"
--strict --scatter "UART_Lab\UART_Lab.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "UART_Lab.map" -o UART_Lab\UART_Lab.axf